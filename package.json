{
  "name": "japan-postal-mcp",
  "version": "0.1.1",
  "description": "MCP server for Japanese postal codes (驛ｵ萓ｿ逡ｪ蜿ｷ): code to address and address to code. Offline, no API keys.",
  "type": "module",
  "bin": {
    "japan-postal-mcp": "src/server.js"
  },
  "exports": "./src/index.js",
  "files": [
    "src",
    "data",
    "MAINTENANCE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "data": "node scripts/build-data.js",
    "demo": "node examples/demo.js",
    "verify:package": "node scripts/verify-package.js",
    "data:check": "node scripts/check-data.js",
    "data:status": "node scripts/check-data.js --remote"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "japan",
    "japanese",
    "postal-code",
    "zipcode",
    "address",
    "claude",
    "codex",
    "驛ｵ萓ｿ逡ｪ蜿ｷ",
    "菴乗園"
  ],
  "author": "Ash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashkobo/japan-postal-mcp.git"
  },
  "homepage": "https://github.com/ashkobo/japan-postal-mcp#readme",
  "bugs": "https://github.com/ashkobo/japan-postal-mcp/issues",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
