{
  "name": "japan-postal-mcp",
  "version": "0.1.0",
  "description": "MCP server for Japanese postal codes (郵便番号): code to address and address to code. Offline, no API keys.",
  "type": "module",
  "bin": {
    "japan-postal-mcp": "src/server.js"
  },
  "exports": "./src/index.js",
  "files": [
    "src",
    "data"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "data": "node scripts/build-data.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "japan",
    "japanese",
    "postal-code",
    "zipcode",
    "address",
    "claude",
    "codex",
    "郵便番号",
    "住所"
  ],
  "author": "Ash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashkobo/japan-postal-mcp.git"
  },
  "homepage": "https://github.com/ashkobo/japan-postal-mcp#readme",
  "bugs": "https://github.com/ashkobo/japan-postal-mcp/issues",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
